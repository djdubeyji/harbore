# ─── Database ────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=changeme_strong_password_here

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_PASSWORD=changeme_redis_password_here

# ─── Auth ────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 64
JWT_SECRET=changeme_jwt_secret_minimum_64_chars_here
JWT_EXPIRY_HOURS=24

# ─── Internal worker authentication ──────────────────────────────────────────
# Generate with: openssl rand -hex 32
WORKER_TOKEN=changeme_worker_internal_token_here

# ─── Scan defaults ───────────────────────────────────────────────────────────
DEFAULT_MAX_CONTAINERS=10
DEFAULT_MAX_RETRIES=3
DEFAULT_RETRY_DELAY_SECONDS=10

# ─── AI module ───────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-
AI_ENABLED=false
AI_URL=http://ai:8090

# ─── Report engine ────────────────────────────────────────────────────────────
REPORT_URL=http://report:8091

# ─── Object storage ──────────────────────────────────────────────────────────
# Local by default. Switch to S3 for production.
STORAGE_TYPE=local
STORAGE_LOCAL_PATH=./data/evidence
# STORAGE_TYPE=s3
# S3_BUCKET=harbore-evidence
# S3_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ─── Nuclei ──────────────────────────────────────────────────────────────────
NUCLEI_ENABLED=true
NUCLEI_TEMPLATES_PATH=/nuclei-templates

# ─── Environment ─────────────────────────────────────────────────────────────
ENV=development
PORT=8080
LOG_LEVEL=info
